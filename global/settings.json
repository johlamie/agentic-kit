{
  "$comment": "Global permissions for the agentic delivery kit. Goal: the pipeline runs fluidly on routine work, and STOPS on anything destructive, costly, or public-facing. Deny rules always win over allow rules.",

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(~/projects/**)",
      "Edit(~/projects/**)",

      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout -b:*)",
      "Bash(git branch:*)", "Bash(git stash:*)",

      "Bash(npm install:*)", "Bash(npm ci:*)", "Bash(npm run:*)",
      "Bash(npx:*)", "Bash(pnpm:*)", "Bash(yarn:*)",
      "Bash(pip install:*)", "Bash(python:*)", "Bash(python3:*)",
      "Bash(pytest:*)", "Bash(node:*)",

      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)",
      "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(touch:*)",
      "Bash(find:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(jq:*)",
      "Bash(curl -s:*)", "Bash(echo:*)", "Bash(which:*)", "Bash(chmod:*)",

      "Bash(npx prisma generate:*)", "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma db seed:*)", "Bash(npx prisma studio:*)",
      "Bash(supabase start:*)", "Bash(supabase status:*)",
      "Bash(supabase db diff:*)", "Bash(supabase db push:*)",
      "Bash(supabase gen types:*)",

      "Bash(npx playwright test:*)", "Bash(npx playwright install:*)",

      "Bash(pm2 list:*)", "Bash(pm2 logs:*)", "Bash(pm2 status:*)",
      "Bash(pm2 restart:*)", "Bash(pm2 start:*)", "Bash(pm2 save:*)",

      "Bash(npx expo:*)", "Bash(eas build:*)", "Bash(eas update:*)",

      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:github.com)",

      "mcp__context7", "mcp__mobbin", "mcp__playwright"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase projects delete:*)",
      "Bash(firebase projects:delete:*)",
      "Bash(firebase deploy:*)",
      "Bash(certbot:*)",
      "Bash(ufw:*)",
      "Bash(systemctl:*)",
      "Bash(nginx:*)",
      "Bash(pm2 delete:*)",
      "Bash(eas submit:*)",
      "Bash(psql:*)",
      "Bash(dropdb:*)",
      "Bash(mysql:*)",
      "Bash(curl -X POST:*)",
      "Read(./.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Write(~/.claude/CLAUDE.md)",
      "Write(~/.claude/agents/**)",
      "Write(~/.claude/skills/**)"
    ]
  },

  "$notes": [
    "deny on git push / certbot / nginx / systemctl / eas submit = these are the G4 gate: the agent proposes the command, you run it or approve it.",
    "deny on ~/.claude/** = the agent cannot silently rewrite its own rules; the retrospective skill proposes diffs, you apply them.",
    "deny on .env / .ssh = secrets never enter the model context.",
    "Adjust as you build trust: the right moment to move a command from deny to allow is after you have approved it manually a dozen times without surprise."
  ]
}
