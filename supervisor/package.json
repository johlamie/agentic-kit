{
  "name": "@agentic-kit/codex-supervisor",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Codex audit daemon for Agentic Delivery Kit",
  "type": "module",
  "bin": {
    "agentic-supervisor": "bin/agentic-supervisor"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/index.js",
    "doctor": "node dist/src/cli/main.js doctor"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
