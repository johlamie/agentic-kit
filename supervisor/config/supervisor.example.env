# Copy to ~/.config/agentic-kit/supervisor.env and chmod 600.
SUPERVISOR_HOST=127.0.0.1
SUPERVISOR_PORT=8787
SUPERVISOR_LEVEL=standard
SUPERVISOR_DATA_DIR=~/.local/state/agentic-kit/supervisor
SUPERVISOR_HOOK_TOKEN_FILE=~/.config/agentic-kit/supervisor-hook-token
SUPERVISOR_AUDIT_CONCURRENCY=1
SUPERVISOR_AUDIT_TIMEOUT_MS=900000
SUPERVISOR_AUDIT_DEBOUNCE_MS=1500
SUPERVISOR_MAX_RETRIES=2
SUPERVISOR_UI_AUDIT=true
SUPERVISOR_UI_SCORE_PASS=85
SUPERVISOR_UI_SCORE_CHALLENGE=70
SUPERVISOR_UI_ALLOW_PROPOSALS=true
SUPERVISOR_UI_PROPOSAL_MODE=isolated
SUPERVISOR_UI_VIEWPORTS=390x844,768x1024,1440x900,1920x1080
SUPERVISOR_BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
SUPERVISOR_NOTIFY_PASS=false

# Optional. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
